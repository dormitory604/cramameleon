    "@mdit/plugin-katex": "1.1.5",
    "@mdit/plugin-tasklist": "1.2.0",
    "fast-xml-parser": "5.12.0",
    "fflate": "0.8.3",
    "katex": "0.19.1",
    "markdown-it": "15.0.3",
    "pdfjs-dist": "6.5.438",
    "react": "19.2.5",
    "react-dom": "19.2.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
