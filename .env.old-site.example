# Fixed production origins; keep the Go listener on loopback behind HTTPS.
APP_ENV=old-site
APP_BIND=127.0.0.1:18085
APP_STATIC_DIR=dist
APP_DATABASE_PATH=var/app.sqlite
APP_PUBLIC_URL=https://cramameleon.example.com
OLD_SITE_URL=https://materials.example.com
OLD_SITE_CLIENT_ID=cramameleon
# A dedicated integration secret shared only by the two backends, not JWT_SECRET.
OLD_SITE_CLIENT_SECRET=replace-with-at-least-32-random-characters
# A separate encryption key: 32 random bytes encoded as 64 hexadecimal characters.
APP_CREDENTIAL_KEY=replace-with-64-hexadecimal-characters
# Explicit old-site numeric IDs, comma separated. Empty is rejected.
APP_ALLOWED_OLD_USER_IDS=
DEEPSEEK_API_KEY=replace-with-real-deepseek-api-key
DEEPSEEK_MODEL=deepseek-flash
APP_DAILY_TOKEN_BUDGET=100000
APP_MAX_OUTPUT_TOKENS=2048
APP_MAX_INPUT_BYTES=64000
GOMEMLIMIT=256MiB
GOMAXPROCS=1
