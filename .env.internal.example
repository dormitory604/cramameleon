# The Go server listens on loopback. Set APP_ALLOW_GUEST=1 for password-free access.
APP_ENV=internal
APP_ALLOW_GUEST=0
APP_BIND=127.0.0.1:18085
APP_STATIC_DIR=dist
APP_BINARY=server/bin/cramameleon
APP_DATABASE_PATH=var/app.sqlite
APP_DEVELOPER_ID=internal-developer
# Required in internal mode. Generate at least 24 random characters.
APP_ACCESS_TOKEN=replace-with-a-random-internal-access-token
# Replace this value, then restart the service.
DEEPSEEK_API_KEY=replace-with-real-deepseek-api-key
DEEPSEEK_MODEL=deepseek-flash
# Global input + output tokens, reset at midnight Asia/Shanghai.
APP_DAILY_TOKEN_BUDGET=1000000
APP_MAX_OUTPUT_TOKENS=393216
APP_MAX_INPUT_BYTES=64000
GOMEMLIMIT=256MiB
GOMAXPROCS=1
